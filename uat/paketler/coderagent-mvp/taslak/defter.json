    "kullanici": [
     "human"
    ],
    "yuzey": "buzz-cli",
    "baslangic": "#coder",
    "otomasyon": "tam",
    "otomasyon_notu": null,
    "persona": "human",
    "hazirlik": [
     {
      "tip": "komut",
      "deger": "scripts/dev-relay.sh up && scripts/dev-relay.sh seed && make build-arm64 && scripts/dev-relay.sh orchestrator",
      "aciklama": "yerel relay, #coder kanalı ve orkestratör ayakta"
     }
    ],
    "adimlar": [
     {
      "n": 1,
      "eylem": "komut",
      "hedef": "scripts/dev-relay.sh buzz human messages send",
      "veri": "--channel $CHANNEL --mention $ORCHESTRATOR_PUBKEY --content \"@coderagent UAT-GIR-01-<zaman> README'ye kurulum bölümü ekle\"",
      "kontrol": "{\"accepted\":true}",
      "kesin": true
     },
     {
      "n": 2,
      "eylem": "bekle",
      "hedef": "poll aralığı",
      "veri": "15 sn",
      "kontrol": null,
      "kesin": true
     },
     {
      "n": 3,
      "eylem": "oku",
      "hedef": "scripts/dev-relay.sh buzz human messages thread",
      "veri": "--channel $CHANNEL --event <1. adımın event_id>",
      "kontrol": null,
      "kesin": true
     }
    ],
    "beklenen": [
     {
      "n": "E1",
      "exp": 0,
      "tip": "kayit",
      "kontrol": "thread'de pubkey=ORCHESTRATOR olan kind:9 event sayısı = 1",
      "kesin": true
     },
     {
      "n": "E2",
      "exp": 1,
      "tip": "kayit",
      "kontrol": "o event'in içeriğinde `<slug>-<6 hex>` biçiminde bir kısa ad var",
      "kesin": false
     },
     {
      "n": "E3",
      "exp": 2,
      "tip": "kayit",
      "kontrol": "orkestratör event'inde [\"e\", <kök>] etiketi var (thread cevabı)",
      "kesin": true
     }
    ],
    "negatif": [
