# bin/: yalnız deploy/Dockerfile'ın kopyaladığı ikililer repoda (BHS gibi; deploy/README.md)
/bin/*
!/bin/coderagent-linux-arm64
!/bin/buzz
!/bin/SHA256SUMS
/dist/
*.sqlite
*.sqlite-*
/state/
.env
.env.*
!.env.example
# uat-kabul-testi: defter kopyası local modda repoya girmez (ANALIZ §5.12)
uat/paketler/*/source/
.auth/

# yerel geliştirme ortamı (scripts/dev-relay.sh)
deploy/dev/.env
deploy/dev/work/
# uat-kabul-testi: taslak sayfa JSON'dan üretilir (yeni-defter.mjs)
uat/paketler/*/taslak/*.html

# tasarım ve plan belgeleri yerelde kalır (public repoya girmez)
/ANALIZ.md
/PLAN.md
